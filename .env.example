# Copiez ce fichier en .env et renseignez vos valeurs.
# Aucune clé secrète n'est requise pour un build statique.

# URL publique du site (sans slash final)
PUBLIC_SITE_URL=https://tapissier-casablanca.ma
PUBLIC_BLOG_URL=https://blog.tapissier-casablanca.ma

# Mesure d'audience (optionnel) — chargé en defer, après interaction.
# Laissez vide pour désactiver.
PUBLIC_GA_ID=
PUBLIC_PLAUSIBLE_DOMAIN=
