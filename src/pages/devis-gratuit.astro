---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import DevisForm from '@/components/DevisForm.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbSchema } from '@/lib/schema';

const lang = 'fr' as const;
const crumbs = [{ name: 'Accueil', url: '/' }, { name: 'Devis gratuit', url: '/devis-gratuit' }];
const points = [
  'Déplacement et prise de mesures à domicile',
  'Devis clair et détaillé, sans engagement',
  'Conseil honnête : on vous dit ce qui vaut la peine',
  'Réponse rapide par téléphone ou WhatsApp',
];
---
<BaseLayout
  lang={lang}
  path="/devis-gratuit"
  title="Devis gratuit — Tapissier à Casablanca | Tapissier Casablanca"
  description="Demandez un devis gratuit pour la réfection ou la fabrication sur mesure de vos meubles à Casablanca. Prise de mesures à domicile, réponse rapide."
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="container-x pt-8 pb-16 grid lg:grid-cols-2 gap-10 items-start">
    <div>
      <p class="eyebrow mb-3">Devis gratuit</p>
      <h1 class="text-4xl md:text-5xl mb-5">Recevez votre devis en quelques heures</h1>
      <p class="text-[var(--color-muted)] mb-8 max-w-md">Décrivez votre projet ci-contre, ou envoyez quelques photos sur WhatsApp. On vous répond vite avec une première estimation, puis on confirme après la prise de mesures.</p>
      <ul class="space-y-3">
        {points.map((p) => (
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-[var(--color-copper)] shrink-0" /><span>{p}</span></li>
        ))}
      </ul>
      <div class="mt-8 card p-5 bg-[var(--color-cream)]">
        <p class="font-display font-bold mb-1">Astuce</p>
        <p class="text-sm text-[var(--color-muted)]">Joignez 2–3 photos de votre meuble (vue d'ensemble + zones usées) : cela permet une estimation plus rapide et plus juste.</p>
      </div>
    </div>
    <div class="card p-6 md:p-8">
      <h2 class="text-2xl mb-5">Votre demande</h2>
      <DevisForm />
    </div>
  </section>
</BaseLayout>
