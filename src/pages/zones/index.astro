---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { business } from '@/data/business';
import { localizedPath as lp } from '@/i18n/ui';

const lang = 'fr' as const;
const zones = (await getCollection('zones'))
  .filter((z) => z.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Accueil', url: '/' }, { name: 'Zones', url: '/zones' }];
---
<BaseLayout
  lang={lang}
  path="/zones"
  title="Tapissier à Casablanca — quartiers desservis | Tapissier Casablanca"
  description="Tapissier Casablanca intervient dans tout le Grand Casablanca : Maârif, Oulfa, Bourgogne, Gauthier, Aïn Diab, Sidi Maârouf, Bouskoura, Aïn Chock, Al Fida. Devis gratuit à domicile."
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="container-x pt-8 pb-10">
    <p class="eyebrow mb-3">Zones desservies</p>
    <h1 class="text-4xl md:text-5xl mb-5 max-w-2xl">Un tapissier dans votre quartier à Casablanca</h1>
    <div class="answer-box max-w-2xl mb-10">
      Nous nous déplaçons à domicile pour la prise de mesures et la livraison dans tout le
      <strong> Grand Casablanca</strong>. Choisissez votre quartier pour voir comment nous y intervenons,
      ou demandez directement un <strong>devis gratuit</strong>.
    </div>

    {zones.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {zones.map((z) => (
          <a href={lp(lang, `/zones/${z.data.slug}`)} class="card p-6 group">
            <span class="grid place-items-center w-11 h-11 rounded-lg bg-[var(--color-copper-soft)] text-[var(--color-copper)] mb-4 group-hover:bg-[var(--color-copper)] group-hover:text-white transition"><Icon name="mapPin" size={22} /></span>
            <h2 class="text-lg mb-1">{z.data.quartier}</h2>
            <p class="text-sm text-[var(--color-muted)]">{z.data.habitat}</p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-[var(--color-copper)] font-display font-semibold text-sm">Voir <Icon name="arrowRight" size={15} /></span>
          </a>
        ))}
      </div>
    ) : (
      <div class="flex flex-wrap gap-2.5">
        {business.areaServed.map((z) => (
          <span class="inline-flex items-center gap-1.5 bg-[var(--color-cream)] border border-[var(--color-line)] rounded-[var(--radius-pill)] px-4 py-2 text-sm"><Icon name="mapPin" size={15} class="text-[var(--color-copper)]" /> {z}</span>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
