---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbSchema } from '@/lib/schema';
import { localizedPath as lp } from '@/i18n/ui';

const lang = 'fr' as const;
const services = (await getCollection('services'))
  .filter((s) => s.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ slug: s.data.slug, title: s.data.title, excerpt: s.data.metaDescription, icon: s.data.icon }));

const crumbs = [{ name: 'Accueil', url: '/' }, { name: 'Services', url: '/services' }];
---
<BaseLayout
  lang={lang}
  path="/services"
  title="Services de tapisserie à Casablanca — Réfection & sur-mesure"
  description="Tous les services de Tapissier Casablanca : salon marocain, canapés, fauteuils, têtes de lit, rideaux, tapisserie automobile, mousse et tissus d'ameublement. Devis gratuit."
  schemas={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="container-x pt-8 pb-12">
    <p class="eyebrow mb-3">Nos services</p>
    <h1 class="text-4xl md:text-5xl mb-5 max-w-2xl">Tapisserie d'ameublement à Casablanca</h1>
    <div class="answer-box max-w-2xl mb-10">
      De la réfection d'un vieux salon marocain à la fabrication sur mesure d'une tête de lit capitonnée,
      Tapissier Casablanca couvre toute la tapisserie d'ameublement. Choisissez votre prestation ci-dessous
      ou demandez directement un <strong>devis gratuit</strong>.
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((s) => <ServiceCard lang={lang} slug={s.slug} title={s.title} excerpt={s.excerpt} icon={s.icon} />)}
    </div>
    <div class="mt-12 rounded-[var(--radius-card)] bg-[var(--color-cream)] p-8 text-center">
      <h2 class="text-2xl mb-2">Vous ne trouvez pas votre besoin&nbsp;?</h2>
      <p class="text-[var(--color-muted)] mb-5">Décrivez-nous votre meuble, on vous dit tout de suite si c'est réalisable.</p>
      <a href={lp(lang,'/devis-gratuit')} class="btn btn-primary">Décrire mon projet <Icon name="arrowRight" size={18} /></a>
    </div>
  </section>
</BaseLayout>
