---
import '@/styles/global.css';
// Polices auto-hébergées (fontsource) — font-display: swap par défaut
import '@fontsource/exo/400.css';
import '@fontsource/exo/600.css';
import '@fontsource/exo/700.css';
import '@fontsource/exo/800.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';

import { getCollection } from 'astro:content';
import SEO from '@/components/SEO.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyCta from '@/components/StickyCta.astro';
import { localBusinessSchema, websiteSchema } from '@/lib/schema';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  lang: Lang;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
}
const { title, description, path, lang, image, type, noindex, schemas = [] } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';

// Navigation data-driven (footer + maillage)
const allServices = await getCollection('services');
const allZones = await getCollection('zones');
const services = allServices
  .filter((s) => s.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ slug: s.data.slug, title: s.data.title }));
const zones = allZones
  .filter((z) => z.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .map((z) => ({ slug: z.data.slug, title: z.data.title }));
---
<!doctype html>
<html lang={lang === 'ar' ? 'ar-MA' : 'fr-MA'} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#17191c" />
    <SEO title={title} description={description} path={path} lang={lang} image={image} type={type} noindex={noindex} />
    <JsonLd schema={localBusinessSchema()} />
    <JsonLd schema={websiteSchema()} />
    {schemas.map((s) => <JsonLd schema={s} />)}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-ink)] focus:text-white focus:px-4 focus:py-2 focus:rounded">{t(lang,'skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} services={services} zones={zones} />
    <StickyCta lang={lang} />
  </body>
</html>

<style is:global>
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .focus\:not-sr-only:focus{position:static;width:auto;height:auto;margin:0;overflow:visible;clip:auto;white-space:normal}
</style>
